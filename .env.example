# Copy to .env and adjust for local development. Never commit a real .env
# (see .gitignore) — this file documents shape and safe local-dev defaults
# only, never a real secret (Security Model §2).

NODE_ENV=local
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=taxitawsila
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

REDIS_URL=redis://localhost:6379

# Dev-only insecure defaults — every environment beyond local MUST override
# these via a real secrets manager (Deployment Strategy §8).
JWT_ACTIVE_KID=dev-key-1
JWT_SECRET=dev-only-insecure-secret-change-me

LOG_LEVEL=info

# Optional — leave unset to disable tracing entirely (ADR-0027).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Integration test database (packages/testing-utils) — usually identical to
# the DATABASE_* values above; kept separate so a dedicated test DB is possible.
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=taxitawsila
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres
